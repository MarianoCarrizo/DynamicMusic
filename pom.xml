<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.marianocarrizo</groupId>
    <artifactId>dynamicMusic</artifactId>
    <version>1.0.0</version>
    <name>dynamicMusic</name>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.2</javafx.version>
        <!--
            Directorio de jmods de JavaFX 21.0.2 (requerido por jpackage/jlink).
            Descargar de https://gluonhq.com/products/javafx/ → SDK → jmods para Windows.
            Sobreescribir con: mvn package -Djavafx.jmods=C:/ruta/a/javafx-jmods-21.0.2
        -->
        <javafx.jmods>C:/javafx-jmods-21.0.2</javafx.jmods>
        <!-- Offline corpus evaluation (AudioAnalyzerCorpusTest) is opt-in: -Dgroups=corpus -DexcludedGroups=none -->
        <excludedGroups>corpus</excludedGroups>
    </properties>

    <repositories>
        <repository>
            <id>be.0110.repo-releases</id>
            <url>https://mvn.0110.be/releases</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-media</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.36</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jflac</groupId>
            <artifactId>jflac-codec</artifactId>
            <version>1.5.2</version>
        </dependency>
        <dependency>
            <groupId>be.tarsos.dsp</groupId>
            <artifactId>core</artifactId>
            <version>2.5</version>
        </dependency>
        <dependency>
            <groupId>be.tarsos.dsp</groupId>
            <artifactId>jvm</artifactId>
            <version>2.5</version>
        </dependency>

        <!-- Gson: serialización JSON para persistencia de sesión (G3) -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.12.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compilador Java 21 con soporte completo para módulos (JPMS) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <executions>
                    <!-- UpdateManagerTest serves fake release assets from the JDK's built-in HTTP server -->
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs>
                                <arg>--add-modules</arg>
                                <arg>jdk.httpserver</arg>
                                <arg>--add-reads</arg>
                                <arg>com.marianocarrizo.dynamicMusic=jdk.httpserver</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <!--
                        Lombok 1.18.x accede a TypeTag.UNKNOWN que fue eliminado en JDK 24,
                        lo cual rompe su inicialización como annotation processor.
                        Como @UtilityClass fue reemplazado por código explícito, deshabilitamos
                        el annotation processing para evitar la carga del LombokProcessor.
                    -->
                    <proc>none</proc>
                </configuration>
            </plugin>

            <!-- Unit tests run on the classpath (no module path) so tests can reach package-private code -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>

            <!-- Plugin de desarrollo para mvn javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <!-- Formato módulo/clase requerido cuando existe module-info.java -->
                    <mainClass>com.marianocarrizo.dynamicMusic/com.marianocarrizo.dynamicMusic.MusicServiceStarter</mainClass>
                </configuration>
            </plugin>

            <!--
                maven-dependency-plugin: copia las dependencias runtime (excluyendo JavaFX y jflac)
                a target/deps para que jpackage/jlink las encuentre en el module-path.
                JavaFX se provee vía jmods; jflac se provee vía moditect → target/modules.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-runtime-deps</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/deps</outputDirectory>
                            <includeScope>runtime</includeScope>
                            <excludeArtifactIds>javafx-controls,javafx-fxml,javafx-media,jflac-codec</excludeArtifactIds>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                moditect: genera descriptores de módulo sintéticos para JARs no modulares.
                Solo jflac-codec lo necesita porque TarsosDSP 2.5 ya incluye module-info.class.
                Los providers SPI de javax.sound.sampled se declaran con 'provides' para que
                ServiceLoader los encuentre correctamente dentro del runtime image de jlink.
                Nombres de clase obtenidos de META-INF/services en jflac-codec-1.5.2.jar.
            -->
            <plugin>
                <groupId>org.moditect</groupId>
                <artifactId>moditect-maven-plugin</artifactId>
                <version>1.2.2.Final</version>
                <executions>
                    <execution>
                        <id>add-module-infos</id>
                        <phase>package</phase>
                        <goals>
                            <goal>add-module-info</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/modules</outputDirectory>
                            <overwriteExistingFiles>true</overwriteExistingFiles>
                            <modules>
                                <module>
                                    <artifact>
                                        <groupId>org.jflac</groupId>
                                        <artifactId>jflac-codec</artifactId>
                                        <version>1.5.2</version>
                                    </artifact>
                                    <moduleInfoSource>
                                        module jflac.codec {
                                            requires java.desktop;
                                            exports org.jflac;
                                            exports org.jflac.frame;
                                            exports org.jflac.io;
                                            exports org.jflac.metadata;
                                            exports org.jflac.sound.spi;
                                            exports org.jflac.util;
                                            provides javax.sound.sampled.spi.AudioFileReader
                                                with org.jflac.sound.spi.FlacAudioFileReader;
                                            provides javax.sound.sampled.spi.FormatConversionProvider
                                                with org.jflac.sound.spi.FlacFormatConversionProvider;
                                        }
                                    </moduleInfoSource>
                                </module>
                            </modules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                jpackage: genera el instalador MSI de Windows con JRE embebido vía jlink.
                Pre-requisitos en la máquina de build:
                  - JDK 21 (jpackage incluido desde JDK 14)
                  - WiX Toolset 3.x (requerido por jpackage para tipo MSI en Windows)
                  - JavaFX 21.0.2 jmods descargados y path configurado en javafx.jmods
                Omitir el instalador en builds de desarrollo: mvn package -DskipInstaller
            -->
            <plugin>
                <groupId>org.panteleyev</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <version>1.6.0</version>
                <executions>
                    <execution>
                        <id>jpackage-msi</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jpackage</goal>
                        </goals>
                        <configuration>
                            <skip>${skipInstaller}</skip>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <name>DynamicMusic</name>
                    <appVersion>1.0.0</appVersion>
                    <vendor>marianocarrizo</vendor>
                    <type>MSI</type>
                    <!-- Formato módulo/clase principal para jlink interno de jpackage -->
                    <module>com.marianocarrizo.dynamicMusic/com.marianocarrizo.dynamicMusic.MusicServiceStarter</module>
                    <modulePaths>
                        <!-- jflac con descriptor sintético generado por moditect -->
                        <modulePath>${project.build.directory}/modules</modulePath>
                        <!-- TarsosDSP (ya modular) + Gson copiados por maven-dependency-plugin -->
                        <modulePath>${project.build.directory}/deps</modulePath>
                        <!-- JAR principal de la aplicación -->
                        <modulePath>${project.build.directory}/${project.artifactId}-${project.version}.jar</modulePath>
                        <!-- jmods de JavaFX 21.0.2 (requeridos por jlink) -->
                        <modulePath>${javafx.jmods}</modulePath>
                    </modulePaths>
                    <destination>${project.build.directory}/dist</destination>
                    <icon>${project.basedir}/icon.ico</icon>
                    <winMenu>true</winMenu>
                    <winShortcut>true</winShortcut>
                    <winDirChooser>true</winDirChooser>
                    <javaOptions>
                        <javaOption>--enable-native-access=javafx.graphics</javaOption>
                    </javaOptions>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!--
            Debug profile: ./mvnw javafx:run -Pdebug
            Enables developer diagnostics (F3 aura HUD + audio-debug.csv recording).
            Never active in the normal run or the MSI build.
        -->
        <profile>
            <id>debug</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.openjfx</groupId>
                        <artifactId>javafx-maven-plugin</artifactId>
                        <configuration>
                            <options>
                                <option>-Ddynamicmusic.debug=true</option>
                            </options>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
