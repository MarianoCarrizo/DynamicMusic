<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox spacing="20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.marianocarrizo.dynamicMusic.Controller.PlayerController" styleClass="root">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <VBox spacing="10" prefWidth="280" minWidth="250">
        <Button text="📂 Open Folder" onAction="#onOpenFolder" maxWidth="Infinity" styleClass="btn-secondary"/>

        <TextField fx:id="txtSearch" promptText="Buscar pista por nombre..."/>

        <ListView fx:id="lstTracks" VBox.vgrow="ALWAYS"/>

        <HBox spacing="8" alignment="CENTER_LEFT">
            <ComboBox fx:id="cmbTrackType" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="Assign" onAction="#onAssignTrack" minWidth="70" styleClass="btn-assign"/>
        </HBox>
    </VBox>

    <Separator orientation="VERTICAL"/>

    <VBox spacing="25" HBox.hgrow="ALWAYS" alignment="CENTER">

        <VBox spacing="5" alignment="CENTER" styleClass="track-info-container">
            <Label text="AMBIENTACIÓN ACTIVA" styleClass="lbl-session-title"/>
            <Label text="Consola Lista" styleClass="lbl-track-active"/>
        </VBox>

        <GridPane hgap="12" vgap="12" alignment="CENTER" VBox.vgrow="ALWAYS">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="ALWAYS"/>
                <RowConstraints vgrow="ALWAYS"/>
            </rowConstraints>

            <children>
                <Button fx:id="btnPaused" text="[1] PAUSED" onAction="#onSwitchToPaused"
                        maxWidth="Infinity" maxHeight="Infinity" styleClass="btn-phase" GridPane.columnIndex="0" GridPane.rowIndex="0"/>

                <Button fx:id="btnNormal" text="[2] NORMAL" onAction="#onSwitchToNormal"
                        maxWidth="Infinity" maxHeight="Infinity" styleClass="btn-phase" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Button fx:id="btnRaged" text="[3] RAGED" onAction="#onSwitchToRaged"
                        maxWidth="Infinity" maxHeight="Infinity" styleClass="btn-phase" GridPane.columnIndex="0" GridPane.rowIndex="1"/>

                <Button fx:id="btnAdvantage" text="[4] ADVANTAGE" onAction="#onSwitchToAdvantage"
                        maxWidth="Infinity" maxHeight="Infinity" styleClass="btn-phase" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            </children>
        </GridPane>

        <VBox spacing="10" alignment="CENTER" styleClass="playback-panel">

            <HBox spacing="20" alignment="CENTER">
                <ToggleButton fx:id="btnLoopIcon" text="🔂" onAction="#onToggleLoop" styleClass="btn-icon-secondary"/>

                <Button text="⏹" onAction="#onStop" styleClass="btn-icon-secondary"/>
                <Button text="▶" onAction="#onPlay" styleClass="btn-icon-main"/>
                <Button text="⏸" onAction="#onPause" styleClass="btn-icon-main"/>

                <Region prefWidth="32" visible="false"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER">
                <Label fx:id="lblCurrentTime" text="0:00" styleClass="lbl-time"/>
                <Slider fx:id="progressSlider" HBox.hgrow="ALWAYS" styleClass="spotify-slider"/>
                <Label fx:id="lblTotalTime" text="0:00" styleClass="lbl-time"/>
            </HBox>
        </VBox>

    </VBox>
</HBox>