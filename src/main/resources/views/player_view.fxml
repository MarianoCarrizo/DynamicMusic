<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.marianocarrizo.dynamicMusic.Controller.PlayerController"
      styleClass="window-root-transparent"
      spacing="0">

    <VBox fx:id="mainRoot" styleClass="main-container" VBox.vgrow="ALWAYS" spacing="0">

        <padding>
            <Insets top="0" right="0" bottom="0" left="0"/>
        </padding>

        <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="window-header">
            <padding>
                <Insets top="8" right="12" bottom="8" left="12"/>
            </padding>
            <Label text="Dynamic Music" styleClass="window-title"/>
            <Region HBox.hgrow="ALWAYS" />

            <Button text="—" onAction="#onMinimizeWindow" styleClass="btn-window-control"/>
            <Button text="✕" onAction="#onCloseWindow" styleClass="btn-window-control, btn-window-close"/>
        </HBox>

        <HBox spacing="20" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="15" right="20" bottom="20" left="20"/>
            </padding>

            <VBox spacing="10" prefWidth="280" minWidth="250">
                <Button text="📂 Open Folder" onAction="#onOpenFolder" maxWidth="Infinity" styleClass="btn-secondary"/>

                <TextField fx:id="txtSearch" promptText="Buscar pista por nombre..."/>

                <ListView fx:id="lstTracks" VBox.vgrow="ALWAYS"/>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <ComboBox fx:id="cmbTrackType" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="Assign" onAction="#onAssignTrack" minWidth="70" styleClass="btn-assign"/>
                </HBox>
            </VBox>

            <Separator orientation="VERTICAL"/>

            <VBox spacing="25" HBox.hgrow="ALWAYS" alignment="CENTER">

                <VBox spacing="5" alignment="CENTER" styleClass="track-info-container">
                    <Label text="AMBIENTACIÓN ACTIVA" styleClass="lbl-session-title"/>
                    <Label text="Consola Lista" styleClass="lbl-track-active"/>
                </VBox>

                <GridPane hgap="12" vgap="12" alignment="CENTER" VBox.vgrow="ALWAYS">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints vgrow="ALWAYS"/>
                        <RowConstraints vgrow="ALWAYS"/>
                    </rowConstraints>

                    <children>
                        <Button fx:id="btnPaused" text="[1] PAUSED" onAction="#onSwitchToPaused"
                                maxWidth="Infinity" maxHeight="Infinity" styleClass="btn-phase" GridPane.columnIndex="0" GridPane.rowIndex="0"/>

                        <Button fx:id="btnNormal" text="[2] NORMAL" onAction="#onSwitchToNormal"
                                maxWidth="Infinity" maxHeight="Infinity" styleClass="btn-phase" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Button fx:id="btnRaged" text="[3] RAGED" onAction="#onSwitchToRaged"
                                maxWidth="Infinity" maxHeight="Infinity" styleClass="btn-phase" GridPane.columnIndex="0" GridPane.rowIndex="1"/>

                        <Button fx:id="btnAdvantage" text="[4] ADVANTAGE" onAction="#onSwitchToAdvantage"
                                maxWidth="Infinity" maxHeight="Infinity" styleClass="btn-phase" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    </children>
                </GridPane>

                <VBox spacing="12" alignment="CENTER" styleClass="playback-panel">
                    <HBox spacing="24" alignment="CENTER" styleClass="transport-controls">
                        <ToggleButton fx:id="btnLoopIcon" text="🔁" onAction="#onToggleLoop" styleClass="btn-spotify-flat, btn-loop"/>
                        <Button text="■" onAction="#onStop" styleClass="btn-spotify-flat, btn-stop"/>

                        <HBox spacing="12" alignment="CENTER">
                            <Button text="▶" onAction="#onPlay" styleClass="btn-spotify-circle, btn-play"/>
                            <Button text="⏸" onAction="#onPause" styleClass="btn-spotify-circle, btn-pause"/>
                        </HBox>

                        <Region prefWidth="28" styleClass="spacer-region"/>
                    </HBox>

                    <HBox spacing="12" alignment="CENTER" styleClass="progress-container">
                        <Label fx:id="lblCurrentTime" text="0:00" styleClass="lbl-time"/>
                        <Slider fx:id="progressSlider" HBox.hgrow="ALWAYS" styleClass="spotify-slider"/>
                        <Label fx:id="lblTotalTime" text="0:00" styleClass="lbl-time"/>
                    </HBox>
                </VBox>

            </VBox>
        </HBox>
    </VBox>
</VBox>